#!/usr/bin/env python3
from pathlib import Path
import sys

APP_VERSION = "8.8"

if "--version" in sys.argv:
    print(f"Devnet RGB Control v{APP_VERSION} GPU hotspot helper")
    raise SystemExit(0)

def sensors():
    out=[]
    for hw in sorted(Path("/sys/class/hwmon").glob("hwmon*")):
        try:
            name=(hw/"name").read_text().strip()
        except Exception:
            continue
        if name != "amdgpu":
            continue
        for label_file in sorted(hw.glob("temp*_label")):
            try:
                label=label_file.read_text().strip()
            except Exception:
                continue
            input_file=label_file.with_name(label_file.name.replace("_label","_input"))
            if not input_file.exists():
                continue
            try:
                value=float(input_file.read_text().strip())/1000.0
            except Exception:
                continue
            out.append((label.lower(), label, input_file, value))
    return out

items=sensors()
matches=[x for x in items if "junction" in x[0] or "hotspot" in x[0] or "hot spot" in x[0]]
if not matches:
    print("ERROR: AMD GPU junction/hotspot hwmon sensor not found", file=sys.stderr)
    if items:
        print("Available AMD GPU sensors:", file=sys.stderr)
        for _,label,path,value in items:
            print(f"  {label}: {value:.2f}C ({path})", file=sys.stderr)
    sys.exit(2)

# Prefer Junction when both names somehow exist.
matches.sort(key=lambda x: (0 if "junction" in x[0] else 1, str(x[2])))
_,label,path,value=matches[0]

if "--path" in sys.argv:
    print(path)
elif "--input-id" in sys.argv:
    print(path.name)
elif "--label" in sys.argv:
    print(label)
elif "--all" in sys.argv:
    for _,lab,p,val in items:
        print(f"{lab}\t{val:.2f}\t{p}")
else:
    print(f"{value:.2f}")
